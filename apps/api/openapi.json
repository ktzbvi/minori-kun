    "components": {
        "schemas": {
            "CompleteBuyerRegistrationRequest": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "name_phonetic": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 255
                    },
                    "phone": {
                        "type": "string",
                        "maxLength": 32
                    },
                    "postal_code": {
                        "type": "string",
                        "maxLength": 16
                    },
                    "prefecture": {
                        "type": "string",
                        "maxLength": 64
                    },
                    "city": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "address_line1": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "address_line2": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 255
                    },
                    "password": {
                        "type": "string"
                    },
                    "terms_accepted": {
                        "enum": [
                            "yes",
                            "on",
                            "1",
                            1,
                            "true",
                            true
                        ]
                    },
                    "password_confirmation": {
                        "type": "string"
                    }
                },
                "required": [
                    "name",
                    "phone",
                    "postal_code",
                    "prefecture",
                    "city",
                    "address_line1",
                    "password",
                    "password_confirmation"
                ],
                "title": "CompleteBuyerRegistrationRequest"
            },
            "CurrentSessionResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "role": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "email_verified": {
                        "type": "boolean"
                    },
                    "display_name": {
                        "type": "string"
                    },
                    "producer": {
                        "type": "object",
                        "properties": {
                            "eligible_to_sell": {
                                "type": "boolean"
                            },
                            "visa_status": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "mastercard_status": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            }
                        },
                        "required": [
                            "eligible_to_sell",
                            "visa_status",
                            "mastercard_status"
                        ]
                    }
                },
                "required": [
                    "id",
                    "role",
                    "email",
                    "email_verified",
                    "display_name"
                ],
                "title": "CurrentSessionResource"
            },
            "PortalLoginRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 255
                    },
                    "password": {
                        "type": "string",
                        "maxLength": 4096
                    }
                },
                "required": [
                    "email",
                    "password"
                ],
                "title": "PortalLoginRequest"
            },
            "StartBuyerRegistrationRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 255
                    }
                },
                "required": [
                    "email"
                ],
                "title": "StartBuyerRegistrationRequest"
            },
            "VerifyBuyerRegistrationOtpRequest": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "string"
                    }
                },
                "required": [
                    "code"
                ],
                "title": "VerifyBuyerRegistrationOtpRequest"
            }
        },
        "responses": {
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            },
            "AuthenticationException": {
                "description": "Unauthenticated",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            }
        }
    }
