            "post": {
                "operationId": "buyerRegistration.start",
                "tags": [
                    "BuyerRegistration"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/StartBuyerRegistrationRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "202": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "email": {
                                                    "type": "string"
                                                },
                                                "next": {
                                                    "type": "string",
                                                    "const": "verify-otp"
                                                },
                                                "otp_expires_at": {
                                                    "type": "string"
                                                },
                                                "resend_available_at": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "email",
                                                "next",
                                                "otp_expires_at",
                                                "resend_available_at"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "const": "A registration code was already sent."
                                        },
                                        "code": {
                                            "type": "string",
                                            "const": "OTP_RESEND_NOT_AVAILABLE"
                                        },
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "email": {
                                                    "type": "string"
                                                },
                                                "resend_available_at": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "email",
                                                "resend_available_at"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "message",
                                        "code",
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
