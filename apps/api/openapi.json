    "components": {
        "schemas": {
            "CompleteProducerRegistrationRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string"
                    },
                    "shop_name": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "contact_name": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "phone": {
                        "type": "string",
                        "maxLength": 32
                    },
                    "password": {
                        "type": "string",
                        "pattern": "[\\x21-\\x2F\\x3A-\\x40\\x5B-\\x60\\x7B-\\x7E]",
                        "minLength": 8,
                        "maxLength": 64
                    },
                    "password_confirmation": {
                        "type": "string"
                    },
                    "photo_id": {
                        "type": "string"
                    },
                    "terms_version": {
                        "type": "string",
                        "maxLength": 64
                    },
                    "accepted_terms": {
                        "enum": [
                            "yes",
                            "on",
                            "1",
                            1,
                            "true",
                            true
                        ]
                    }
                },
                "required": [
                    "shop_name",
                    "contact_name",
                    "phone",
                    "password",
                    "password_confirmation",
                    "photo_id",
                    "terms_version",
                    "accepted_terms"
                ],
                "title": "CompleteProducerRegistrationRequest"
            },
            "CurrentSessionResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "role": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "email_verified": {
                        "type": "boolean"
                    },
                    "display_name": {
                        "type": "string"
                    },
                    "producer": {
                        "type": "object",
                        "properties": {
                            "eligible_to_sell": {
                                "type": "boolean"
                            },
                            "visa_status": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "mastercard_status": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            }
                        },
                        "required": [
                            "eligible_to_sell",
                            "visa_status",
                            "mastercard_status"
                        ]
                    }
                },
                "required": [
                    "id",
                    "role",
                    "email",
                    "email_verified",
                    "display_name"
                ],
                "title": "CurrentSessionResource"
            },
            "PortalLoginRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 255
                    },
                    "password": {
                        "type": "string",
                        "maxLength": 4096
                    }
                },
                "required": [
                    "email",
                    "password"
                ],
                "title": "PortalLoginRequest"
            },
            "ProducerOnboardingStatusResource": {
                "type": "object",
                "properties": {
                    "state": {
                        "type": "string",
                        "enum": [
                            "application_required",
                            "eligible"
                        ]
                    },
                    "eligible_to_sell": {
                        "type": "boolean"
                    },
                    "application_available": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "state",
                    "eligible_to_sell",
                    "application_available"
                ],
                "title": "ProducerOnboardingStatusResource"
            },
            "ProducerRegistrationDetailsResource": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string"
                    },
                    "terms": {
                        "type": "object",
                        "properties": {
                            "version": {
                                "type": "string"
                            },
                            "title": {
                                "type": "string"
                            },
                            "content": {
                                "type": "string"
                            },
                            "is_sample": {
                                "type": "boolean"
                            }
                        },
                        "required": [
                            "version",
                            "title",
                            "content",
                            "is_sample"
                        ]
                    },
                    "photo": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "properties": {
                            "id": {
                                "type": "string"
                            },
                            "preview_url": {
                                "type": "string"
                            },
                            "expires_at": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "id",
                            "preview_url",
                            "expires_at"
                        ]
                    },
                    "session_expires_at": {
                        "type": "string"
                    }
                },
                "required": [
                    "email",
                    "terms",
                    "photo",
                    "session_expires_at"
                ],
                "title": "ProducerRegistrationDetailsResource"
            },
            "ProducerRegistrationPhotoResource": {
                "type": "object",
